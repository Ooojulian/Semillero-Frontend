NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/semillero
JWT_SECRET=change-this-to-a-long-random-secret-minimum-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Optional: SMTP config for email notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# SMTP_FROM=no-reply@semillero.app
